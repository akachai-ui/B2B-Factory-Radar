# Google Maps / Places API Key
# รับ API Key ได้ที่ https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ภาษาผลลัพธ์ (th = ภาษาไทย, en = ภาษาอังกฤษ)
LANGUAGE_CODE=th

# ประเภทสถานที่ตาม Google Places API (New)
# manufacturer = ผู้ผลิต / โรงงาน
INCLUDED_TYPE=manufacturer
